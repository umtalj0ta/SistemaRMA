@page "/"
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject SistemaRMA.Services.EmailService EmailService

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1>Sistema de Gestão de RMA</h1>
        <p class="lead">Escolha o perfil para simular.</p>
    </div>

    <div class="d-grid gap-3 col-md-4 mx-auto">

        <button class="btn btn-primary btn-lg"
                @onclick="@(() => Navigation.NavigateTo("/novo_pedido"))">
            Utilizador
        </button>

        <button class="btn btn-success btn-lg"
                @onclick="@(() => Navigation.NavigateTo("/gestor"))">
            Gestor
        </button>

        <button class="btn btn-warning btn-lg"
                @onclick="@(() => Navigation.NavigateTo("/administrador"))">
            Administrador
        </button>

    </div>

</div>