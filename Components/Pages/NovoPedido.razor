@page "/novo_pedido"
@rendermode InteractiveServer // para a pagina ser interativa , os campos do form nao estavam a ser guardados
@using SistemaRMA.Entities
@using SistemaRMA.Services
@inject RmaService RmaService


<h3>Novo Pedido RMA</h3>

<EditForm Model="pedido"
          OnValidSubmit="GuardarPedido"
          FormName="PedidoRMA">

    <div class="mb-3">
        <label>Equipamento</label>
        <InputText @bind-Value="pedido.Equipamento"
                   class="form-control" />
    </div>

  <div class="mb-3">
        <label>Número de Série</label>
        <InputText @bind-Value="pedido.NumeroSerie"
                   class="form-control" />
    </div>

    <div class="mb-3">
        <label>Descrição do Problema</label>
        <InputTextArea @bind-Value="pedido.DescricaoProblema"
                       class="form-control" />
    </div>

    <button class="btn btn-primary" type="submit">
        Guardar Pedido
    </button>

</EditForm>  

@code {
    private PedidoRMA pedido = new();

 private async Task GuardarPedido()
{
    pedido.CriadoA = DateTime.Now;
    pedido.EstadoId = 1;
     // temporario até ter o login

    pedido.CriadoPorID = "313b010a-1490-42e7-af64-8b064b4f28fb";

    await RmaService.CreateAsync(pedido);


    pedido = new PedidoRMA();
}
}