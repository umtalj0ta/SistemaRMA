@page "/pedidos"

@using SistemaRMA.Entities
@using SistemaRMA.Services

@inject RmaService RmaService

@rendermode InteractiveServer

<h3>Lista de Pedidos RMA</h3>

@if (pedidos == null)
{
    <p>A carregar...</p>
}
else if (pedidos.Count == 0)
{
    <p>Não existem pedidos.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Equipamento</th>
                <th>Número Série</th>
                <th>Estado</th>
                <th>Data</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var pedido in pedidos)
            {
                <tr>
                    <td>@pedido.ID</td>
                    <td>@pedido.Equipamento</td>
                    <td>@pedido.NumeroSerie</td>
                    <td>@pedido.Estado.Nome</td>
                    <td>@pedido.CriadoA</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    private List<PedidoRMA>? pedidos;

    protected override async Task OnInitializedAsync()
    {
        pedidos = await RmaService.GetAllAsync();
    }

}