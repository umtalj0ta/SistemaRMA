@page "/gestor"

@using SistemaRMA.Models
@using SistemaRMA.Services

@inject RmaService RmaService

@rendermode InteractiveServer

<h3>Pedidos para Aprovação do Gestor</h3>

@if (pedidos == null)
{
    <p>A carregar...</p>
}
else if (pedidos.Count == 0)
{
    <p>Não existem pedidos para aprovar.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Equipamento</th>
                <th>Número Série</th>
                <th>Estado</th>
                <th>Data</th>
                <th>Descricao</th>
                <th>Ação</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var pedido in pedidos)
            {
                <tr>
                    <td>@pedido.ID</td>
                    <td>@pedido.Equipamento</td>
                    <td>@pedido.NumeroSerie</td>
                    <td>@pedido.Estado</td>
                    <td>@pedido.CriadoA</td>
                    <td>@pedido.DescricaoProblema</td>

                    <td>
                        <button class="btn btn-success"
                                @onclick="() => AprovarPedido(pedido)">
                            Aprovar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    private List<PedidoRMA> pedidos = new();

    protected override async Task OnInitializedAsync()
    {
        pedidos = await RmaService.GetByEstadoAsync("Novo");
    }

    private async Task AprovarPedido(PedidoRMA pedido)
    {
        pedido.Estado = "Aprovado Gestor";

        await RmaService.UpdateAsync(pedido);

        pedidos = await RmaService.GetByEstadoAsync("Novo");
    }

}